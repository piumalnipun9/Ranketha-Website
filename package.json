{
  "name": "robo-club",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build:server": "tsc -p server/tsconfig.json",
    "build": "npm run build:server && npm install --prefix client && npm run build --prefix client",
    "start": "NODE_ENV=production node server/dist/index.js",
    "dev:server": "npm run build:server && node server/dist/index.js",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently --kill-others-on-fail \"npm run dev:server\" \"npm run dev:client\"",
    "prisma:generate": "prisma generate --schema server/prisma/schema.prisma",
    "heroku-postbuild": "npm run prisma:generate && npm run prisma:generate --prefix client && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "19.2.17",
    "concurrently": "^9.2.1",
    "prisma": "^6.14.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "@types/node": "^20.19.25",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "next": "^14.2.33",
    "nodemailer": "^6.9.10"
  },
  "engines": {
    "node": "20.x",
    "npm": "10.x"
  }
}
